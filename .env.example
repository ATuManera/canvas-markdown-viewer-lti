# canvas-markdown-viewer-lti — example configuration.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every value below is a placeholder: none of them is a real credential.

# ---------------------------------------------------------------------------
# Where the tool is served
# ---------------------------------------------------------------------------

NODE_ENV=production

# Public HTTPS base URL, without a trailing slash. Every URL handed to Canvas is
# derived from it, so it is configured rather than inferred from request headers,
# which a client controls.
PUBLIC_URL=https://markdown.example.edu

HOST=0.0.0.0
PORT=3000

# Set to true when a reverse proxy sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Used by compose.yaml for the PostgreSQL container.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Used by the application. With compose.yaml this is set for you; set it here
# only when you run PostgreSQL yourself.
# DATABASE_URL=postgres://cmv:change-me@db:5432/cmv

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# AES-256-GCM keys for the stored refresh tokens, as `version:base64key`,
# comma-separated. 32 bytes each. Generate one with:
#
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
#
# To rotate: add a second key, point ENCRYPTION_ACTIVE_KEY at it, let the tool
# re-wrap, then remove the old one.
ENCRYPTION_KEYS=1:REPLACE_WITH_32_RANDOM_BYTES_BASE64

# Which key seals new values. Defaults to the last entry above.
# ENCRYPTION_ACTIVE_KEY=1

# Key that signs the session token and the OAuth2 state. At least 32 characters.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
STATE_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# ---------------------------------------------------------------------------
# Canvas instances
# ---------------------------------------------------------------------------

# A JSON array, one entry per Canvas. See docs/installation/canvas-self-hosted.md
# for where each value comes from.
#
# `issuer` is the `iss` of the id_token. `authorizationEndpoint` and `jwksUri` are
# on the OIDC auth domain, which is NOT always the Canvas domain: Instructure-hosted
# Canvas uses canvas.instructure.com as the issuer and sso.canvaslms.com for OIDC.
#
# `downloadHostAllowlist` is only needed when the instance serves files from a
# separate domain or from object storage.
CANVAS_PLATFORMS=[{"issuer":"https://canvas.example.edu","label":"Example University","clientId":"10000000000001","deploymentIds":["1:abcdef0123456789"],"authorizationEndpoint":"https://canvas.example.edu/api/lti/authorize_redirect","jwksUri":"https://canvas.example.edu/api/lti/security/jwks","apiBaseUrl":"https://canvas.example.edu","apiClientId":"10000000000002","apiClientSecret":"REPLACE_WITH_THE_API_DEVELOPER_KEY_SECRET","downloadHostAllowlist":[]}]

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Interface language when the launch does not say. `es` or `en`.
DEFAULT_LOCALE=es

# Largest Markdown file the viewer will fetch and render, in bytes.
MAX_FILE_BYTES=2000000

# How long to wait for Canvas, in milliseconds.
FETCH_TIMEOUT_MS=10000

# How many redirects a download may follow. Canvas uses at most one.
MAX_REDIRECTS=3

# Ceilings on a single document, so one file cannot occupy the process.
MAX_MARKDOWN_NODES=50000
MAX_RENDER_MS=3000

# Remote images are blocked by default: loading one tells its host the reader's
# address, browser and which document they are reading. Turn this on only if your
# institution has weighed that.
ALLOW_EXTERNAL_IMAGES=false

# `persistent` keeps the encrypted refresh token, so each user authorises once.
# `session` discards it when the browser session ends, at the cost of asking again.
TOKEN_PERSISTENCE=persistent

LOG_LEVEL=info
